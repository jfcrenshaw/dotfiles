# VSCode integrated terminals don't inherit shell functions defined during setup
# of the login shell. The following re-sources the Lmod init to fix this,
# using the already-set $MODULESHOME. (this is for Perlmutter)
if [[ -n "$MODULESHOME" && "${+functions[module]}" -eq 0 ]]; then
    source "$MODULESHOME/init/zsh"
fi
